{
  "identifier": "com.mason.bob-plugin-google-tts",
  "version": "1.0.0",
  "category": "tts",
  "name": "Google TTS (Chirp 3)",
  "summary": "基于 Google Cloud Text-to-Speech API 开发，支持 Chirp 3 高清拟真大模型音色与多语种自然朗读",
  "icon": "icon.png",
  "author": "mason",
  "homepage": "https://github.com/bricklayor/bob-plugin-google-tts",
  "appcast": "https://raw.githubusercontent.com/bricklayor/bob-plugin-google-tts/main/appcast.json",
  "minBobVersion": "1.8.0",
  "options": [
    {
      "identifier": "api_key",
      "type": "text",
      "title": "API Key",
      "defaultValue": "",
      "desc": "Google Cloud Console 生成的 API Key（需在 GCP 启用 Cloud Text-to-Speech API）",
      "textConfig": {
        "type": "secure",
        "placeholderText": "请输入 Google Cloud API Key"
      }
    },
    {
      "identifier": "chinese_voice",
      "type": "menu",
      "title": "中文音色 (Chinese)",
      "defaultValue": "cmn-CN-Chirp3-HD-Kore",
      "menuValues": [
        { "title": "cmn-CN-Chirp3-HD-Kore (女声 - 亲切自然 / 推荐)", "value": "cmn-CN-Chirp3-HD-Kore" },
        { "title": "cmn-CN-Chirp3-HD-Charon (男声 - 沉稳磁性 / 推荐)", "value": "cmn-CN-Chirp3-HD-Charon" },
        { "title": "cmn-CN-Chirp3-HD-Aoede (女声 - 清晰温和)", "value": "cmn-CN-Chirp3-HD-Aoede" },
        { "title": "cmn-CN-Chirp3-HD-Fenrir (男声 - 浑厚有力)", "value": "cmn-CN-Chirp3-HD-Fenrir" },
        { "title": "cmn-CN-Chirp3-HD-Puck (男声 - 活泼生动)", "value": "cmn-CN-Chirp3-HD-Puck" },
        { "title": "cmn-CN-Chirp3-HD-Leda (女声 - 知性优雅)", "value": "cmn-CN-Chirp3-HD-Leda" }
      ],
      "desc": "朗读中文文本（普通话）时使用的 Chirp 3 HD 发音人音色"
    },
    {
      "identifier": "english_voice",
      "type": "menu",
      "title": "英文音色 (English)",
      "defaultValue": "en-US-Chirp3-HD-Charon",
      "menuValues": [
        { "title": "en-US-Chirp3-HD-Charon (男声 - 专业沉稳 / 推荐)", "value": "en-US-Chirp3-HD-Charon" },
        { "title": "en-US-Chirp3-HD-Kore (女声 - 自然生动 / 推荐)", "value": "en-US-Chirp3-HD-Kore" },
        { "title": "en-US-Chirp3-HD-Aoede (女声 - 清澈温和)", "value": "en-US-Chirp3-HD-Aoede" },
        { "title": "en-US-Chirp3-HD-Fenrir (男声 - 浑厚质感)", "value": "en-US-Chirp3-HD-Fenrir" },
        { "title": "en-US-Chirp3-HD-Puck (男声 - 热情生动)", "value": "en-US-Chirp3-HD-Puck" },
        { "title": "en-US-Chirp3-HD-Leda (女声 - 典雅自然)", "value": "en-US-Chirp3-HD-Leda" }
      ],
      "desc": "朗读英文文本时使用的 Chirp 3 HD 发音人音色"
    },
    {
      "identifier": "other_voice_gender",
      "type": "menu",
      "title": "其他语种性格匹配",
      "defaultValue": "Kore",
      "menuValues": [
        { "title": "Kore (女声 - 自然通用 / 推荐)", "value": "Kore" },
        { "title": "Charon (男声 - 沉稳通用 / 推荐)", "value": "Charon" },
        { "title": "Aoede (女声 - 清晰明亮)", "value": "Aoede" },
        { "title": "Fenrir (男声 - 浑厚磁性)", "value": "Fenrir" },
        { "title": "Puck (男声 - 活泼生动)", "value": "Puck" },
        { "title": "Leda (女声 - 知性温和)", "value": "Leda" }
      ],
      "desc": "朗读日、韩、法、德、西、俄等其他 50 余种语言时，默认匹配的 Chirp 3 HD 统一音色角色"
    },
    {
      "identifier": "custom_voice",
      "type": "text",
      "title": "自定义音色 (可选)",
      "defaultValue": "",
      "desc": "若填写具体的 Voice Name（例如 ja-JP-Chirp3-HD-Kore 或 Journey / Neural2 音色），将强制优先使用此音色；留空则按语言智能匹配",
      "textConfig": {
        "type": "visible",
        "placeholderText": "例如 ja-JP-Chirp3-HD-Kore（留空按语种自动匹配）"
      }
    },
    {
      "identifier": "audio_encoding",
      "type": "menu",
      "title": "音频编码格式",
      "defaultValue": "MP3",
      "menuValues": [
        { "title": "MP3 (推荐，体积小且兼容性佳)", "value": "MP3" },
        { "title": "OGG_OPUS (高保真高压缩比)", "value": "OGG_OPUS" },
        { "title": "LINEAR16 (无损 PCM 未压缩)", "value": "LINEAR16" }
      ],
      "desc": "Google TTS 服务端返回的音频流编码格式"
    },
    {
      "identifier": "custom_domain",
      "type": "text",
      "title": "自定义 API 地址 / 反代",
      "defaultValue": "",
      "desc": "反向代理地址。留空使用官方地址 https://texttospeech.googleapis.com",
      "textConfig": {
        "type": "visible",
        "placeholderText": "例如 https://my-tts-proxy.example.com"
      }
    }
  ]
}
